# Oviora Backend Environment Variables Example

# LLM API Keys
GEMINI_API_KEY="your_gemini_api_key_here"
GROQ_API_KEY="your_groq_api_key_here"

# Security
SECRET_KEY="your_secret_key_here"

# App Settings
APP_NAME="Oviora Hormone Intelligence"
DEBUG=False
HOST="0.0.0.0"
PORT=8000

# OCR Settings
OCR_LANGUAGE="en"
OCR_USE_GPU=False

# API Models URL for Frontend connection
NEXT_PUBLIC_API_URL="http://localhost:8000"
